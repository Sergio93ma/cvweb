{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/cv",
        "destination": "/assets/CV/CV_Sergio_Martin_2026.pdf",
        "type": 301
      },
      {
        "source": "/linkedin",
        "destination": "https://www.linkedin.com/in/sergio93ma/",
        "type": 301
      },
      {
        "source": "/github",
        "destination": "https://github.com/sergio93ma",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "max-age=3600, must-revalidate" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|avif|ico|svg|pdf)",
        "headers": [{ "key": "Cache-Control", "value": "max-age=86400, public" }]
      },
      {
        "source": "/_astro/**",
        "headers": [{ "key": "Cache-Control", "value": "max-age=31536000, immutable" }]
      }
    ]
  }
}
