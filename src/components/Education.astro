---
import SectionTitle from './SectionTitle.astro';
import DateRange from './DateRange.astro';
import { education } from '../data/education';
import { t, type Lang } from '../i18n';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;

/** "IES Julián Marías" -> "IES_JULIAN_MARIAS" (terminal look, same as the Angular snakecase pipe) */
const snakeUpper = (value: string) =>
    value
        .normalize('NFD')
        .replace(/[^\w\s-]|[̀-ͯ]/g, '')
        .trim()
        .replace(/\s+/g, '_')
        .toUpperCase();
---

<section class="education" id="education">
    <SectionTitle lang={lang} title="education.title" />
    <div class="education__list">
        {
            education.map((e) => (
                <div class="education__item">
                    <div class="education__item-header">
                        <i class="fa-regular fa-folder" aria-hidden="true" />
                        <i class="fa-regular fa-folder-open" aria-hidden="true" />
                        <h3 class="education__header-title" data-i18n={`education.items.${e.id}`}>
                            {t(lang, `education.items.${e.id}`)}
                        </h3>
                    </div>
                    <div class="education__item-details">
                        <div class="detail dates">
                            <span class="arrow" aria-hidden="true">↳</span>
                            <span class="title">
                                <span data-i18n="education.dates">{t(lang, 'education.dates')}</span>:
                            </span>
                            <span class="content">
                                <DateRange lang={lang} start={e.start} end={e.end} />
                            </span>
                        </div>
                        <div class="detail institution">
                            <span class="arrow" aria-hidden="true">↳</span>
                            <span class="title">
                                <span data-i18n="education.institution">{t(lang, 'education.institution')}</span>:
                            </span>
                            <span class="content">{snakeUpper(e.institution)}</span>
                        </div>
                        <div class="detail location">
                            <span class="arrow" aria-hidden="true">↳</span>
                            <span class="title">
                                <span data-i18n="education.location">{t(lang, 'education.location')}</span>:
                            </span>
                            <span class="content" data-i18n={`education.locations.${e.location}`}>
                                {t(lang, `education.locations.${e.location}`)}
                            </span>
                        </div>
                    </div>
                </div>
            ))
        }
    </div>
</section>

<style lang="scss">
    @use '../styles/tokens' as *;

    .education {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 5rem;

        @media (max-width: $mobile) {
            gap: 3rem;
        }

        &__list {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        // Angular rendered this title in a <span>: keep the inherited text style on the <h3>
        &__header-title {
            font-size: inherit;
            font-weight: inherit;
        }

        &__item {
            font-family: var(--font-mono);
            cursor: default;

            &-header {
                display: flex;
                align-items: center;
                gap: 1rem;
                font-size: 1.5rem;

                @media (max-width: $mobile) {
                    font-size: 1.15rem;
                }

                .fa-folder {
                    color: var(--primary-color);
                }

                .fa-folder-open {
                    display: none;
                    color: var(--primary-color);
                }

                .title {
                    font-weight: 700;
                    font-size: 1.125rem;
                    line-height: 1.75rem;

                    &:hover {
                        color: var(--primary-color);
                    }
                }
            }

            &-details {
                display: flex;
                flex-direction: column;
                gap: 0.5rem;
                margin-left: 3.5rem;
                margin-top: 0.75rem;
                max-height: 0px;
                overflow: hidden;
                border-left: 2px solid rgba(19, 109, 236, 0.2);
                padding-left: 1.5rem;
                opacity: 0;
                transition: all 500ms var(--cubic-normal);

                @media (max-width: $mobile) {
                    margin-left: 0.7rem;
                    gap: 1rem;
                }

                .detail {
                    display: flex;
                    gap: 1rem;

                    @media (max-width: $mobile) {
                        flex-wrap: wrap;
                        row-gap: 0.2rem;

                        .content {
                            flex: 1 0 100%;
                        }
                    }

                    .title {
                        text-transform: uppercase;
                    }

                    .arrow {
                        color: var(--primary-color);
                    }
                    &.dates {
                        .content {
                            color: var(--secondary-40);
                        }
                    }
                    &.institution {
                        .content {
                            color: var(--grayscale-40);
                        }
                    }
                    &.location {
                        .content {
                            border-radius: var(--border-radius);
                            background-color: var(--grayscale-90);
                            padding: 0.125rem 0.5rem;
                            color: var(--primary-color);
                        }
                    }
                }
            }

            &:hover {
                .education__item-header {
                    .fa-folder {
                        display: none;
                    }
                    .fa-folder-open {
                        display: block;
                    }
                }
                .education__item-details {
                    max-height: 10rem;
                    opacity: 1;

                    @media (max-width: $mobile) {
                        max-height: 13rem;
                    }
                }
            }
        }
    }
</style>
