---
import SectionTitle from './SectionTitle.astro';
import DateRange from './DateRange.astro';
import { experiences } from '../data/experience';
import { dictionaries, t, type Lang } from '../i18n';
import { BUILD_MIN_CLIP, BUILD_WIDTH, timelineLayout, timelineTracks, timelineYears } from '../scripts/timeline';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
type ExperienceId = keyof (typeof dictionaries)['en']['experience']['items'];
// Bullet keys come from the English dictionary; every language must keep the same number of bullets.
const itemKeys = (id: string) =>
    dictionaries.en.experience.items[id as ExperienceId].items.map((_, n) => `experience.items.${id}.items.${n}`);
// Build-time layout with default sizes; the client script redoes it with the visitor's date and real measurements.
const now = new Date();
const years = timelineYears(experiences, now);
const layout = timelineLayout(experiences, now, BUILD_WIDTH, experiences.map(() => BUILD_MIN_CLIP));
const trackOf = timelineTracks(experiences);
const tracks = [...new Set(trackOf)]
    .sort((a, b) => a - b)
    .map((track) => experiences.map((e, index) => ({ e, index })).filter(({ index }) => trackOf[index] === track));
---

<section class="experience" id="experience">
    <SectionTitle lang={lang} title="experience.title" />
    <div class="timeline">
        <div class="timeline__viewport">
            <div class="timeline__body" style={`--tracks: ${tracks.length}`}>
                <div class="timeline__ruler" aria-hidden="true">
                    {
                        years.map(({ year }, n) => (
                            <span class="tick" style={layout.ticks[n]}>
                                <span>{year}</span>
                            </span>
                        ))
                    }
                </div>
                {
                    tracks.map((clips, n) => (
                        <>
                            <span class="timeline__label" style={`grid-row: ${n + 2}`} aria-hidden="true">
                                V{tracks.length - n}
                            </span>
                            <div class="timeline__track" style={`grid-row: ${n + 2}`}>
                                {clips.map(({ e, index }) => (
                                    <button
                                        type="button"
                                        class="clip"
                                        id={`clip-${e.id}`}
                                        style={layout.clips[index]}
                                        data-index={index}
                                        aria-expanded="false"
                                        aria-controls={`inspector-${e.id}`}
                                    >
                                        <span class="clip__title" data-i18n={`experience.items.${e.id}.title`}>
                                            {t(lang, `experience.items.${e.id}.title`)}
                                        </span>
                                        <span class="clip__company" data-i18n={`experience.items.${e.id}.company`}>
                                            {t(lang, `experience.items.${e.id}.company`)}
                                        </span>
                                    </button>
                                ))}
                            </div>
                        </>
                    ))
                }
                <div class="timeline__overlay" aria-hidden="true">
                    <div class="timeline__playhead" style={layout.playhead}></div>
                </div>
            </div>
        </div>

        {
            experiences.map((e) => (
                <section class="inspector" id={`inspector-${e.id}`} aria-labelledby={`inspector-${e.id}-title`} hidden>
                    <div class="inspector__header">
                        <div>
                            <h3 class="inspector__title" id={`inspector-${e.id}-title`} data-i18n={`experience.items.${e.id}.title`}>
                                {t(lang, `experience.items.${e.id}.title`)}
                            </h3>
                            <span class="inspector__company">
                                <b data-i18n={`experience.items.${e.id}.company`}>{t(lang, `experience.items.${e.id}.company`)}</b>{' '}
                                — <span data-i18n={`experience.items.${e.id}.location`}>
                                    {t(lang, `experience.items.${e.id}.location`)}
                                </span>
                            </span>
                        </div>
                        <button
                            type="button"
                            class="inspector__close button-reset"
                            aria-label={t(lang, 'experience.close')}
                            data-i18n-attr="aria-label:experience.close"
                        >
                            <i class="fa-solid fa-xmark" aria-hidden="true" />
                        </button>
                    </div>
                    <small class="inspector__dates">
                        <DateRange lang={lang} start={e.start} end={e.end} />
                    </small>
                    <ul class="inspector__items">
                        {itemKeys(e.id).map((key) => (
                            <li data-i18n={key}>{t(lang, key)}</li>
                        ))}
                    </ul>
                    <ul class="inspector__technologies">
                        {e.technologies.map((tech) => (
                            <li>{tech}</li>
                        ))}
                    </ul>
                </section>
            ))
        }
    </div>
</section>

<script>
    import { experiences } from '../data/experience';
    import { timelineLayout, timelineYears } from '../scripts/timeline';

    const timeline = document.querySelector<HTMLElement>('.timeline');

    if (timeline) {
        const now = new Date();
        const ruler = timeline.querySelector<HTMLElement>('.timeline__ruler')!;
        const lane = timeline.querySelector<HTMLElement>('.timeline__track')!;
        const playhead = timeline.querySelector<HTMLElement>('.timeline__playhead')!;
        const clips = [...timeline.querySelectorAll<HTMLButtonElement>('.clip')];

        // A new year started since the build: add its mark to the ruler
        const years = timelineYears(experiences, now);
        if (ruler.children.length !== years.length) {
            ruler.replaceChildren(
                ...years.map(({ year }) => {
                    const tick = Object.assign(document.createElement('span'), { className: 'tick' });
                    tick.append(Object.assign(document.createElement('span'), { textContent: String(year) }));
                    return tick;
                }),
            );
        }
        const ticks = [...ruler.children] as HTMLElement[];

        const viewport = timeline.querySelector<HTMLElement>('.timeline__viewport')!;
        let firstLayout = true;

        // Every clip must fit its own title and company: measure them, then warp the scale around them.
        // All reads happen first and all writes after, so the browser lays the page out only once.
        const layout = () => {
            const width = lane.clientWidth;
            if (!width) return;
            const mins: number[] = [];
            for (const clip of clips) {
                const style = getComputedStyle(clip);
                const chrome = clip.offsetWidth - clip.clientWidth + parseFloat(style.paddingLeft) + parseFloat(style.paddingRight);
                const text = Math.max(...[...clip.children].map((child) => child.scrollWidth));
                mins[Number(clip.dataset.index)] = Math.ceil(text + chrome + 2);
            }
            const labelWidths = ticks.map((tick) => (tick.firstElementChild as HTMLElement).offsetWidth);
            const tickPadding = parseFloat(getComputedStyle(ticks[0]!).paddingLeft) + 1;

            const result = timelineLayout(experiences, now, width, mins);
            for (const clip of clips) clip.setAttribute('style', result.clips[Number(clip.dataset.index)]!);
            ticks.forEach((tick, n) => tick.setAttribute('style', result.ticks[n]!));
            playhead.setAttribute('style', result.playhead);

            // Where the scale is compressed, year labels would overlap: keep the current year, drop the ones too close.
            // A label that would stick out of the ruler goes to the left of its mark.
            let boundary = width;
            for (let n = ticks.length - 1; n >= 0; n--) {
                const tick = ticks[n]!;
                const x = result.ticksAt[n]! * width;
                const flip = x + tickPadding + labelWidths[n]! > width;
                const [left, right] = flip ? [x - tickPadding - labelWidths[n]!, x] : [x, x + tickPadding + labelWidths[n]!];
                const fits = n === ticks.length - 1 || right + 6 <= boundary;
                tick.toggleAttribute('data-flip', flip);
                (tick.firstElementChild as HTMLElement).style.visibility = fits ? '' : 'hidden';
                if (fits) boundary = left;
            }

            // Narrow screens scroll the tracks sideways, like an editor: start on the present
            if (firstLayout) viewport.scrollLeft = viewport.scrollWidth;
            firstLayout = false;
        };

        // Runs right after the browser's own layout (first time included), so measuring costs nothing extra
        new ResizeObserver(layout).observe(lane);
        // The language switch changes the labels' width
        new MutationObserver(() => requestAnimationFrame(layout)).observe(document.documentElement, { attributeFilter: ['lang'] });

        // Entry animation: clips wipe in behind the playhead
        const observer = new IntersectionObserver(
            (entries) => {
                if (!entries[0]?.isIntersecting) return;
                observer.disconnect();
                timeline.dataset.animated = 'true';
            },
            { threshold: 0.8 },
        );
        observer.observe(viewport);

        // Clips open their inspector below the tracks; one at a time
        const inspectorOf = (clip: HTMLButtonElement) => document.getElementById(clip.getAttribute('aria-controls')!)!;
        const close = (clip: HTMLButtonElement) => {
            clip.setAttribute('aria-expanded', 'false');
            inspectorOf(clip).hidden = true;
        };

        for (const clip of clips) {
            clip.addEventListener('click', () => {
                const opening = clip.getAttribute('aria-expanded') !== 'true';
                clips.forEach(close);
                if (!opening) return;
                clip.setAttribute('aria-expanded', 'true');
                const inspector = inspectorOf(clip);
                inspector.hidden = false;
                inspector.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            });
            inspectorOf(clip)
                .querySelector('.inspector__close')
                ?.addEventListener('click', () => {
                    close(clip);
                    clip.focus();
                });
        }

        timeline.addEventListener('keydown', (event) => {
            if (event.key !== 'Escape') return;
            const open = clips.find((clip) => clip.getAttribute('aria-expanded') === 'true');
            if (!open) return;
            close(open);
            open.focus();
        });
    }
</script>

<style lang="scss">
    @use '../styles/tokens' as *;

    .experience {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 5rem;

        @media (max-width: $mobile) {
            gap: 3rem;
        }
    }

    // Video-editor timeline. Positions (--l, --r, --x) come from the warped scale in scripts/timeline.ts
    .timeline {
        --animation: 1.2s;

        display: flex;
        flex-direction: column;
        gap: 1rem;

        // Below ~36rem the lanes stop shrinking and scroll inside the timeline (the page never scrolls sideways)
        &__viewport {
            overflow-x: auto;
            overscroll-behavior-x: contain;
            scrollbar-width: thin;
            scrollbar-color: var(--grayscale-50) transparent;
            // Room for the playhead's diamond, which sticks out above the ruler
            padding-top: 0.3rem;
        }

        &__body {
            min-width: 36rem;
            display: grid;
            grid-template-columns: 2.25rem 1fr;
            grid-template-rows: 1.75rem repeat(var(--tracks), 3.5rem);
            row-gap: 0.5rem;

            @media (max-width: $mobile) {
                grid-template-columns: 1.75rem 1fr;
                grid-template-rows: 1.75rem repeat(var(--tracks), 3rem);
            }
        }

        &__ruler {
            grid-column: 2;
            grid-row: 1;
            position: relative;
            color: var(--grayscale-30);
            font-size: 0.8rem;
            font-family: var(--font-mono);
            border-bottom: 1px solid var(--grayscale-60);

            @media (max-width: $mobile) {
                font-size: 0.7rem;
            }

            // :global() because the client script rebuilds the ticks when a new year starts
            :global(.tick) {
                position: absolute;
                top: 0;
                bottom: 0;
                left: var(--x);
                border-left: 1px solid var(--grayscale-50);
                padding-left: 0.3rem;
                line-height: 1;
            }

            // Set by the script when a label would overflow the ruler's right edge: it goes left of its mark
            :global(.tick[data-flip] span) {
                position: absolute;
                right: 0.3rem;
            }
        }

        &__label {
            grid-column: 1;
            align-self: center;
            color: var(--grayscale-30);
            font-family: var(--font-mono);
            font-size: 0.8rem;
        }

        &__track {
            grid-column: 2;
            position: relative;
            border-radius: var(--border-radius);
            background-color: color-mix(in srgb, var(--grayscale-60) 25%, transparent);
        }

        &__overlay {
            grid-column: 2;
            grid-row: 1 / -1;
            position: relative;
            pointer-events: none;
        }

        &__playhead {
            position: absolute;
            top: 0;
            bottom: 0;
            left: var(--x);
            width: 1px;
            background-color: var(--primary-color);
            box-shadow: 0 0 10px var(--primary-color);
            opacity: 0;

            &::before {
                content: '';
                position: absolute;
                left: -0.375rem;
                top: -0.25rem;
                height: 0.75rem;
                width: 0.75rem;
                transform: rotate(45deg);
                background-color: var(--primary-color);
            }
        }

        &[data-animated='true'] &__playhead {
            animation: playhead-sweep var(--animation) linear forwards;
        }
    }

    .clip {
        position: absolute;
        top: 0;
        bottom: 0;
        left: var(--l);
        right: var(--r);
        padding: 0 0.6rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        // Labels keep their own width, so the script can measure what each clip needs
        align-items: flex-start;
        min-width: 0;
        appearance: none;
        font: inherit;
        color: inherit;
        text-align: left;
        cursor: pointer;
        border: 1px solid rgb(255 255 255 / 0.1);
        border-left: 3px solid var(--accent);
        border-radius: var(--border-radius);
        background: linear-gradient(90deg, var(--grayscale-70) 0%, var(--grayscale-60) 100%);
        clip-path: inset(0 100% 0 0);
        transition: var(--time-fast) var(--cubic-normal);
        transition-property: border-color, background-color;

        .timeline[data-animated='true'] & {
            // Each clip appears when the playhead reaches its start
            animation: clip-wipe calc(var(--duration) * var(--animation)) linear forwards;
            animation-delay: calc(var(--delay) * var(--animation));
        }

        &:hover {
            border-color: var(--grayscale-50);
            border-left-color: var(--accent);
        }

        // The clip-path would cut a regular outline
        &:focus-visible {
            outline: 2px solid var(--primary-color);
            outline-offset: -4px;
        }

        &[aria-expanded='true'] {
            border-color: var(--primary-color);
            background: color-mix(in srgb, var(--primary-color) 22%, var(--grayscale-70));

            // Blue on the blue-tinted background falls below 4.5:1
            .clip__company {
                color: var(--text-primary);
            }
        }

        // Ellipsis only as a last resort, on screens too narrow for every label
        &__title,
        &__company {
            // While the tracks scroll (narrow screens), labels stay at the visible start of their clip
            position: sticky;
            left: 0.6rem;
            max-width: 100%;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        &__title {
            font-size: 0.95rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: -0.03em;

            @media (max-width: $mobile) {
                font-size: 0.8rem;
            }
        }

        &__company {
            font-size: 0.85rem;
            color: var(--primary-color);

            @media (max-width: $mobile) {
                font-size: 0.75rem;
            }
        }
    }

    .inspector {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 1.2rem 1.4rem;
        border-radius: var(--border-radius);
        border: 1px solid color-mix(in srgb, var(--primary-color) 45%, transparent);
        background: linear-gradient(90deg, var(--grayscale-70) 0%, var(--grayscale-60) 100%);
        animation: slide-up-fade-in var(--time-slow) var(--cubic-normal);

        &[hidden] {
            display: none;
        }

        &__header {
            display: flex;
            justify-content: space-between;
            align-items: start;
            gap: 1rem;
        }

        &__title {
            font-size: 1.2rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: -0.05em;
        }

        &__company {
            color: var(--primary-color);
        }

        &__close {
            font-size: 1.5rem;
            line-height: 1;
            min-width: 1.5rem;
            min-height: 1.5rem;
        }

        &__dates {
            font-family: var(--font-mono);
        }

        &__items {
            list-style: none;
            margin: 0;
            padding-left: 1.3rem;
            color: var(--grayscale-20);
            font-family: var(--font-mono);

            li::marker {
                content: '- ';
            }
        }

        &__technologies {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            list-style: none;
            margin: 0;
            padding: 0;

            li {
                display: inline-flex;
                align-items: center;
                padding: 0.4rem 0.8rem;
                border-radius: 9999px;
                background: rgba(19, 109, 236, 0.15);
                color: var(--primary-50);
                font-size: 0.8rem;
                font-weight: 600;
                border: 1px solid rgba(19, 109, 236, 0.3);
                text-transform: uppercase;
                letter-spacing: 0.05em;
                transition: 0.3s ease;
                transition-property: background-color, border-color;

                &:hover {
                    background: rgba(19, 109, 236, 0.25);
                    border-color: rgba(19, 109, 236, 0.5);
                }

                @media (max-width: $mobile) {
                    padding: 0.35rem 0.7rem;
                    font-size: 0.7rem;
                }
            }
        }
    }

    @keyframes playhead-sweep {
        from {
            left: 0%;
            opacity: 0;
        }
        10% {
            opacity: 1;
        }
        to {
            opacity: 1;
        }
    }

    @keyframes clip-wipe {
        to {
            clip-path: inset(0 0 0 0);
        }
    }
</style>
