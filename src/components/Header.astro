---
import { nav } from '../data/nav';
import { langPath, t, type Lang } from '../i18n';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
---

<nav id="Header">
    <a class="header__position" href={langPath[lang]}>
        <div class="header__position-icon">
            <i class="fa-solid fa-code" aria-hidden="true"></i>
        </div>
        <div class="header__position-text">
            <p class="name">Sergio Martín Alonso</p>
            <span class="experience" data-i18n="header.role">{t(lang, 'header.role')}</span>
        </div>
    </a>
    <ul class="header__menu">
        {
            nav
                .filter((item) => item.label)
                .map((item) => (
                    <li data-section={item.id}>
                        <button type="button" class="button-reset" data-i18n={`header.nav.${item.id}`}>
                            {t(lang, `header.nav.${item.id}`)}
                        </button>
                    </li>
                ))
        }
    </ul>
    <div class="header__info">
        <div class="header__info-status">
            <span class="status__icon status__icon--available"></span>
            <span class="status__text" data-i18n="header.status">{t(lang, 'header.status')}</span>
        </div>
    </div>
</nav>

<script>
    import { nav } from '../data/nav';
    import { scrollToSection } from '../scripts/scroll';

    const items = document.querySelectorAll<HTMLLIElement>('#Header .header__menu li');

    for (const li of items) {
        li.querySelector('button')?.addEventListener('click', () => scrollToSection(li.dataset.section!));
    }

    // Highlight the section that is mostly in view
    const observer = new IntersectionObserver(
        (entries) => {
            const visible = entries.find((e) => e.isIntersecting);
            if (!visible) return;
            for (const li of items) {
                const active = li.dataset.section === visible.target.id;
                li.classList.toggle('active', active);
                li.querySelector('button')?.toggleAttribute('aria-current', active);
            }
        },
        { threshold: 0.8 },
    );
    for (const { id } of nav) {
        const el = document.getElementById(id);
        if (el) observer.observe(el);
    }
</script>

<style lang="scss">
    @use '../styles/tokens' as *;

    #Header {
        position: fixed;
        left: 50%;
        transform: translateX(-50%);
        top: 1.5rem;
        z-index: 100;
        width: 100%;
        max-width: calc(1280px - 3rem);
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-radius: var(--border-radius);
        padding: 0.75rem 1.5rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        background: var(--overbg-color-t);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.08);

        @media (max-width: $tablet) {
            display: none;
        }

        .header__position {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            color: inherit;

            &-icon {
                display: flex;
                width: 2rem;
                height: 2rem;
                align-items: center;
                justify-content: center;
                border-radius: 0.5rem;
                background-color: var(--primary-70);
                box-shadow: 0 0 20px rgba(19, 109, 236, 0.4);
            }
            &-text {
                display: flex;
                flex-direction: column;

                .name {
                    font-size: 1.17em;
                    line-height: 1.35rem;
                    font-weight: 700;
                    letter-spacing: -0.02em;
                }
                .experience {
                    color: var(--primary-70);
                    letter-spacing: 0.1em;
                    line-height: 1;
                    text-transform: uppercase;
                    font-weight: 700;
                    font-size: 10px;
                }
            }
        }
        .header__menu {
            list-style: none;
            display: flex;
            align-items: center;
            gap: 2rem;

            li {
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.2em;
                cursor: pointer;

                &.active {
                    color: var(--primary-color);
                }
            }
        }

        .header__info {
            display: flex;
            align-items: center;
            gap: 1rem;
            border-left: 1px solid var(--grayscale-60);
            padding-left: 1.5rem;

            &-status {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                border-radius: 2rem;
                border: 1px solid var(--grayscale-70);
                background-color: var(--grayscale-60);
                padding: 0.375rem 1rem;
                transition: all var(--time-fast) var(--cubic-normal);
                cursor: pointer;

                &:hover {
                    background-color: var(--grayscale-70);
                }

                .status__icon {
                    width: 0.5rem;
                    height: 0.5rem;
                    border-radius: 0.5rem;

                    &--available {
                        background-color: rgb(16, 185, 129);
                        box-shadow: 0 0 10px rgb(16, 185, 129);
                    }
                }
                .status__text {
                    font-size: 10px;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: 0.1em;
                    color: var(--grayscale-20);
                }
            }
        }
    }
</style>
