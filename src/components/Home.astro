---
import Base from '../layouts/Base.astro';
import AnimatedBg from './AnimatedBg.astro';
import Header from './Header.astro';
import AboutMe from './AboutMe.astro';
import Summary from './Summary.astro';
import Skills from './Skills.astro';
import Experience from './Experience.astro';
import Education from './Education.astro';
import Databox from './Databox.astro';
import Projects from './Projects.astro';
import Footer from './Footer.astro';
import type { Lang } from '../i18n';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
---

<Base lang={lang}>
    <AnimatedBg />
    <Header lang={lang} />
    <main class="container">
        <AboutMe lang={lang} />
        <Summary lang={lang} />
        <Skills lang={lang} />
        <Experience lang={lang} />
        <Education lang={lang} />
        <Databox lang={lang} />
        <Projects lang={lang} />
    </main>
    <Footer lang={lang} />
</Base>

<style lang="scss">
    @use '../styles/tokens' as *;

    .container {
        // 1280px of content plus side padding: below ~1440px the content never touches
        // the viewport edges (fixed footer, year axis overhang)
        max-width: calc(1280px + 10rem);
        padding: 6rem 5rem 15rem;
        margin: auto;
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 10rem;

        @media (max-width: $desktop) {
            padding: 6rem 5rem;
            max-width: unset;
            width: 100vw;
        }
        @media (max-width: $tablet) {
            padding: 2rem 1.5rem;
            gap: 8rem;
            position: fixed;
            inset: 0;
            overflow: auto;
            mask-image: linear-gradient(to bottom, black calc(100% - 128px), transparent calc(100% - 48px), transparent 100%);
        }
        @media (max-width: $mobile) {
            padding: 2rem 2rem 6rem;
            gap: 6rem;
        }
    }
</style>
