---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionTitle from './SectionTitle.astro';
import { projects } from '../data/projects';
import type { Lighthouse } from '../data/types';
import { t, type Lang } from '../i18n';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/images/projects/*.webp', { eager: true });
const image = (id: string) => images[`../assets/images/projects/${id}.webp`]!.default;
const metricOrder: (keyof Lighthouse)[] = ['performance', 'accessibility', 'bestPractices', 'SEO'];
---

<section class="projects" id="projects">
    <SectionTitle lang={lang} title="projects.title" description="projects.description" />
    <div class="projects__grid">
        {
            projects.map((p) => (
                <div class="project" data-project={p.id}>
                    <div class="project__image">
                        {p.type === 'confidential' && (
                            <div class="confidential__overlay">
                                <i class="fa-solid fa-lock" aria-hidden="true" />
                            </div>
                        )}
                        <Image
                            src={image(p.id)}
                            widths={[400, 600, 800, 1200]}
                            sizes="(max-width: 992px) 90vw, 600px"
                            alt={t(lang, `projects.items.${p.id}.title`)}
                            data-i18n-attr={`alt:projects.items.${p.id}.title`}
                        />
                    </div>
                    <div class="project__body">
                        <h3 class="project__body-title">
                            <button type="button" class="button-reset" aria-haspopup="dialog">
                                {p.icon && (
                                    <>
                                        <i class={p.icon} aria-hidden="true" />
                                        &nbsp;{" "}
                                    </>
                                )}
                                <span data-i18n={`projects.items.${p.id}.title`}>{t(lang, `projects.items.${p.id}.title`)}</span>
                            </button>
                        </h3>
                        <span class="project__body-company">{p.company}</span>
                        <p class="project__body-description" data-i18n={`projects.items.${p.id}.summary`}>
                            {t(lang, `projects.items.${p.id}.summary`)}
                        </p>
                        <div class="project__body-links">
                            {p.url && (
                                <a href={p.url} aria-label={t(lang, 'projects.visit')} data-i18n-attr="aria-label:projects.visit">
                                    <i class="fa-solid fa-link" aria-hidden="true" />
                                </a>
                            )}
                            {p.github && (
                                <a href={p.github} aria-label={t(lang, 'projects.seeCode')} data-i18n-attr="aria-label:projects.seeCode">
                                    <i class="fa-brands fa-github" aria-hidden="true" />
                                </a>
                            )}
                        </div>
                    </div>
                </div>
            ))
        }
    </div>

    {
        projects.map((p) => (
            <dialog class="projects__modal" id={`project-${p.id}`} aria-labelledby={`project-${p.id}-title`}>
                <div class="project">
                    <button
                        type="button"
                        class="project__close button-reset"
                        aria-label={t(lang, 'projects.close')}
                        data-i18n-attr="aria-label:projects.close"
                    >
                        <i class="fa-solid fa-xmark" aria-hidden="true" />
                    </button>
                    <div class="project__header">
                        <h2 class="project__header-title" id={`project-${p.id}-title`}>
                            {p.icon && (
                                <>
                                    <i class={p.icon} aria-hidden="true" />
                                    &nbsp;{" "}
                                </>
                            )}
                            <span data-i18n={`projects.items.${p.id}.title`}>{t(lang, `projects.items.${p.id}.title`)}</span>
                        </h2>
                        <span class="project__header-divisor" aria-hidden="true">
                            ——
                        </span>
                        <span class="project__header-company">{p.company}</span>
                    </div>
                    <div class="project__body">
                        <div class="project__body-left">
                            <div class="project__image">
                                {p.type === 'confidential' && (
                                    <div class="confidential__overlay">
                                        <i class="fa-solid fa-lock" aria-hidden="true" />
                                    </div>
                                )}
                                <Image
                                    src={image(p.id)}
                                    widths={[400, 600, 800, 1200]}
                                    sizes="(max-width: 992px) 90vw, 30vw"
                                    alt={t(lang, `projects.items.${p.id}.title`)}
                                    data-i18n-attr={`alt:projects.items.${p.id}.title`}
                                />
                            </div>
                            {p.metrics?.lighthouse && (
                                <div class="project__metrics">
                                    <h3 class="project__metrics-title" data-i18n="projects.performanceImpact">
                                        {t(lang, 'projects.performanceImpact')}
                                    </h3>
                                    <div class="project__metrics-grid">
                                        {metricOrder.map((metric) => (
                                            <div class="metric">
                                                <div class="metric__spinner" style={`--value: ${p.metrics!.lighthouse![metric]}`}>
                                                    <span class="metric__spinner-label">{p.metrics!.lighthouse![metric]}</span>
                                                </div>
                                                <span class="metric__text" data-i18n={`projects.metrics.${metric}`}>
                                                    {t(lang, `projects.metrics.${metric}`)}
                                                </span>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            )}
                        </div>
                        <div class="project__body-right">
                            <div
                                class="project__description"
                                data-i18n-html={`projects.items.${p.id}.description`}
                                set:html={t(lang, `projects.items.${p.id}.description`)}
                            />
                            <div class="project__technologies">
                                <h3 class="project__metrics-title" data-i18n="projects.technologies">
                                    {t(lang, 'projects.technologies')}
                                </h3>
                                <div class="project__technologies-grid">
                                    {p.technologies.map((tech) => (
                                        <div class="technology">{tech}</div>
                                    ))}
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="project__buttons">
                        {p.github && (
                            <a href={p.github} class="button-liquid">
                                <span data-i18n="projects.seeCode">{t(lang, 'projects.seeCode')}</span>
                                <i class="fa-solid fa-rectangle-terminal" aria-hidden="true" />
                            </a>
                        )}
                        {p.url && (
                            <a href={p.url} class="button-solid">
                                <span data-i18n="projects.visit">{t(lang, 'projects.visit')}</span>
                                <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true" />
                            </a>
                        )}
                    </div>
                </div>
            </dialog>
        ))
    }
</section>

<script>
    const root = document.documentElement;

    // Cards: reveal on scroll, open their dialog on click
    const reveal = new IntersectionObserver(
        (entries) => {
            for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.add('visible');
                reveal.unobserve(entry.target);
            }
        },
        { threshold: 0.1, rootMargin: '0px 0px -50px 0px' },
    );

    for (const card of document.querySelectorAll<HTMLElement>('.projects__grid .project')) {
        reveal.observe(card);
        const dialog = document.getElementById(`project-${card.dataset.project}`) as HTMLDialogElement | null;
        card.addEventListener('click', (event) => {
            if ((event.target as Element).closest('a')) return; // external links keep their own behaviour
            if (!dialog) return;
            dialog.showModal();
            root.style.overflow = 'hidden';
        });
    }

    // Dialogs: close on the X, on the backdrop or with Esc
    for (const dialog of document.querySelectorAll<HTMLDialogElement>('.projects__modal')) {
        dialog.addEventListener('click', (event) => {
            if (event.target === dialog) dialog.close();
        });
        dialog.querySelector('.project__close')?.addEventListener('click', () => dialog.close());
        dialog.addEventListener('close', () => (root.style.overflow = ''));
    }
</script>

<style lang="scss">
    @use '../styles/tokens' as *;

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .projects {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 5rem;

        @media (max-width: $mobile) {
            gap: 3rem;
        }
        &__grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(400px, 100%), 1fr));
            gap: 2rem;
            // Biggest chunk of the page: skip its style/layout until it nears the viewport.
            // The clip margin keeps the cards' hover shadow visible despite paint containment.
            content-visibility: auto;
            contain-intrinsic-size: auto 1000px;
            overflow-clip-margin: 4rem;

            @media (max-width: $tablet) {
                contain-intrinsic-size: auto 2600px;
            }

            .project {
                display: flex;
                flex-direction: column;
                background-color: var(--overbg-color);
                border: 1px solid var(--grayscale-60);
                border-radius: var(--border-radius);
                overflow: hidden;
                transition: var(--time-slow) var(--cubic-normal);
                transition-property: transform, border-color, box-shadow;
                opacity: 0;
                transform: translateY(30px);

                &.visible {
                    animation: fadeInUp 0.6s var(--cubic-normal) forwards;
                }

                &:hover {
                    border-color: var(--primary-color);
                    box-shadow: var(--floating-shadow);
                    transform: scale(1.01) translateY(-2px);
                    cursor: pointer;
                }

                &__body {
                    padding: 1rem;
                    display: flex;
                    flex-direction: column;
                    gap: 0.4rem;
                    height: 100%;

                    &-title {
                        margin: 0;
                        font-size: 1.5rem;
                        line-height: 2rem;
                        font-weight: 700;
                        letter-spacing: -0.025em;

                        @media (max-width: $tablet) {
                            font-size: 1.3rem;
                            line-height: 1.7rem;
                        }

                        i {
                            color: var(--primary-color);
                        }
                    }

                    &-company {
                        font-family: var(--font-mono);
                        font-size: 1.2rem;
                    }

                    &-description {
                        flex: 1 0 0;
                    }

                    &-links {
                        display: flex;
                        gap: 0.6rem;

                        i {
                            font-size: 1.3rem;
                        }
                    }
                }
            }
        }

        // <dialog> acting as the full-screen overlay of the Angular version
        &__modal {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            max-width: none;
            max-height: none;
            margin: 0;
            padding: 0;
            border: 0;
            color: inherit;
            background-color: var(--overbg-color-t);
            backdrop-filter: blur(15px);
            align-items: center;
            justify-content: center;
            z-index: 300;

            &[open] {
                display: flex;
            }

            &::backdrop {
                background: transparent;
            }

            .project {
                position: relative;
                max-width: 70vw;
                max-height: 90vh;
                padding: 2rem;
                display: flex;
                flex-direction: column;
                gap: 1.5rem;
                z-index: 310;
                background-color: var(--overbg-color);
                border-radius: var(--border-radius);
                box-shadow: var(--floating-shadow);

                @media (max-width: $tablet) {
                    max-width: 90vw;
                    max-height: 86vh;
                    margin-bottom: 8vh;
                    overflow: auto;
                }

                &__close {
                    position: absolute;
                    font-size: 2rem;
                    top: 1rem;
                    right: 1rem;
                    line-height: 1;
                }

                &__header {
                    display: flex;
                    align-items: center;
                    gap: 0.8rem;

                    @media (max-width: $tablet) {
                        flex-direction: column;
                        align-items: start;
                    }

                    &-title {
                        font-size: 2em;

                        @media (max-width: $tablet) {
                            font-size: 1.5rem;
                        }
                        i {
                            color: var(--primary-color);
                        }
                    }
                    &-divisor {
                        @media (max-width: $tablet) {
                            display: none;
                        }
                    }
                    &-company {
                        font-family: var(--font-mono);
                        font-size: 1.2rem;
                    }
                }

                &__body {
                    display: flex;
                    gap: 1.5rem;

                    @media (max-width: $tablet) {
                        flex-direction: column;
                    }

                    &-left {
                        display: flex;
                        flex-direction: column;
                        gap: 1.5rem;
                        flex: 1 0 35%;
                    }
                    &-right {
                        display: flex;
                        flex-direction: column;
                        gap: 1.5rem;
                        flex: 1 0 65%;
                    }

                    // Angular used <h4> here; same look on <h3>
                    h3 {
                        font-size: 1em;
                        color: var(--primary-color);
                        text-transform: uppercase;
                        font-family: var(--font-mono);
                    }
                }

                &__metrics {
                    display: flex;
                    flex-direction: column;
                    gap: 0.6rem;

                    &-grid {
                        display: grid;
                        grid-template-columns: repeat(auto-fit, minmax(min(100px, 100%), 1fr));

                        .metric {
                            display: flex;
                            flex-direction: column;
                            align-items: center;
                            gap: 0.6rem;

                            &__spinner {
                                width: 70px;
                                height: 70px;
                                border-radius: 50%;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                position: relative;
                                animation: pct-fill 1.2s var(--cubic-normal) forwards;

                                &::before {
                                    content: '';
                                    position: absolute;
                                    inset: 0;
                                    border-radius: 50%;
                                    background: conic-gradient(
                                        var(--primary-color) calc(var(--anim-pct) * 1%),
                                        color-mix(in srgb, var(--primary-color) 18%, transparent) 0
                                    );
                                    mask: radial-gradient(
                                        farthest-side,
                                        transparent calc(100% - 10px),
                                        black calc(100% - 10px + 0.5px)
                                    );
                                }

                                &-label {
                                    font-weight: 500;
                                    line-height: 1;
                                    z-index: 1;
                                    position: relative;
                                }
                            }

                            &__text {
                                font-size: 0.8rem;
                            }
                        }
                    }
                }
                &__technologies {
                    display: flex;
                    flex-direction: column;
                    gap: 0.6rem;

                    &-grid {
                        display: flex;
                        flex-wrap: wrap;
                        gap: 0.8rem;

                        .technology {
                            padding: 1rem 2rem;
                            background-color: color-mix(in srgb, var(--grayscale-50) 20%, transparent);
                            border-left: 4px solid var(--primary-color);
                            border-radius: 0 var(--border-radius) var(--border-radius) 0;

                            @media (max-width: $tablet) {
                                flex: 1 0 0;
                            }
                        }
                    }
                }

                &__buttons {
                    display: flex;
                    justify-content: end;
                    gap: 1rem;

                    @media (max-width: $tablet) {
                        flex-direction: column;
                    }
                }
            }
        }

        .project__image {
            position: relative;
            width: 100%;

            .confidential__overlay {
                position: absolute;
                inset: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                backdrop-filter: blur(10px);

                i {
                    font-size: 3rem;
                    color: var(--primary-color);
                    border-radius: 100%;
                    width: 6rem;
                    height: 6rem;
                    line-height: 1.9;
                    border: 2px solid var(--primary-color);
                }
            }

            :global(img) {
                width: 100%;
                height: auto;
            }
        }
    }
</style>
