---
import SectionTitle from './SectionTitle.astro';
import { skillCategories } from '../data/skills';
import { t, type Lang } from '../i18n';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const levels = [1, 2, 3, 4, 5];
---

<section class="skills" id="skills">
    <SectionTitle lang={lang} title="skills.title" />
    <div class="skills__container">
        <div class="skills__categories">
            {
                skillCategories.map((c, index) => (
                    <div class:list={['category', { active: index === 0 }]}>
                        <div class="category__header">
                            <h3>
                                <button
                                    type="button"
                                    class="button-reset"
                                    aria-expanded={index === 0 ? 'true' : 'false'}
                                    data-i18n={`skills.categories.${c.id}`}
                                >
                                    {t(lang, `skills.categories.${c.id}`)}
                                </button>
                            </h3>
                        </div>
                        <div class="category__skills">
                            {c.skills.map((s) => (
                                <div class="skill">
                                    <h4 class="skill__title">
                                        {s.icon && <i class={s.icon} aria-hidden="true" />}
                                        <span data-i18n={`skills.items.${s.id}.name`}>
                                            {t(lang, `skills.items.${s.id}.name`)}
                                        </span>
                                    </h4>
                                    <div class="skill__more">
                                        <div class="skill__more-description" data-i18n={`skills.items.${s.id}.description`}>
                                            {t(lang, `skills.items.${s.id}.description`)}
                                        </div>
                                        <div class="skill__more-subdescription">
                                            <div class="experience">
                                                <div class="title" data-i18n="skills.exp">
                                                    {t(lang, 'skills.exp')}
                                                </div>
                                                <div class="value">
                                                    {s.experience} <span data-i18n="common.years">{t(lang, 'common.years')}</span>
                                                </div>
                                            </div>
                                            <div class="keywords">
                                                <div class="title" data-i18n="skills.keywords">
                                                    {t(lang, 'skills.keywords')}
                                                </div>
                                                <div class="value" data-i18n={`skills.items.${s.id}.keywords`}>
                                                    {t(lang, `skills.items.${s.id}.keywords`)}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <ul class="skill__progress">
                                        {levels.map((level) => (
                                            <li class:list={['skill__progress-bar', { fill: level <= s.knowledge }]} />
                                        ))}
                                    </ul>
                                </div>
                            ))}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<script>
    const categories = [...document.querySelectorAll<HTMLElement>('.skills .category')];

    const activate = (index: number) => {
        categories.forEach((category, i) => {
            category.classList.toggle('active', i === index);
            category.querySelector('button')?.setAttribute('aria-expanded', String(i === index));
        });
    };

    categories.forEach((category, index) => {
        // Clicking the open category goes back to the first one (same as the Angular version)
        category.querySelector('.category__header')?.addEventListener('click', () => {
            activate(category.classList.contains('active') ? 0 : index);
        });
    });
</script>

<style lang="scss">
    @use '../styles/tokens' as *;

    .skills {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 5rem;

        @media (max-width: $mobile) {
            gap: 3rem;
        }

        &__container {
            width: 100%;
            position: relative;
        }

        &__categories {
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
            height: 40rem;
            width: 22%;

            @media (max-width: $tablet) {
                flex-direction: row;
                width: 100%;
                height: auto;
                padding-bottom: 38rem;
            }

            @media (max-width: $mobile) {
                overflow: auto;
            }

            .category {
                flex: 1 0 0;

                &__header {
                    cursor: pointer;
                    margin-bottom: 0;
                    width: 100%;
                    height: 100%;
                    display: flex;
                    align-items: center;
                    border-radius: var(--border-radius);
                    background-color: var(--grayscale-70);
                    padding: 1rem 1.5rem;
                    text-align: left;
                    font-family: var(--font-mono);
                    font-size: 0.875rem;
                    line-height: 1.25rem;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: -0.025em;
                    color: var(--grayscale-30);
                    transition: 350ms var(--cubic-normal);
                    transition-property: transform, background-color, color;

                    @media (min-width: $tablet) {
                        &:hover {
                            background-color: var(--grayscale-60);
                            transform: scale(1.05);
                        }
                    }

                    @media (max-width: $tablet) {
                        height: 100%;
                    }
                }

                &.active {
                    .category__header {
                        color: var(--grayscale-10);
                        background-color: var(--grayscale-60);
                    }

                    .category__skills {
                        opacity: 1;
                        transform: scaleX(1);

                        .skill {
                            &__progress {
                                &-bar {
                                    transform: scaleX(1);
                                }
                            }
                        }
                    }
                }

                &__skills {
                    position: absolute;
                    width: calc(78% - 1rem);
                    height: 100%;
                    right: 0;
                    top: 0;
                    display: flex;
                    flex-direction: column;
                    gap: 0.2rem;
                    opacity: 0;
                    // Grows from its right edge: never sticks out of the container (no horizontal scroll)
                    transform-origin: right center;
                    transform: scaleX(0);
                    transition: var(--time-normal) var(--cubic-normal);
                    transition-property: transform, opacity;

                    @media (max-width: $tablet) {
                        width: 100%;
                        height: calc(100% - 92px - 1rem);
                        top: calc(92px + 1rem);
                    }

                    .skill {
                        display: flex;
                        flex-direction: column;
                        justify-content: space-between;
                        max-height: 20rem;
                        cursor: pointer;
                        border-radius: var(--border-radius);
                        border: 1px solid var(--grayscale-70);
                        background-color: var(--grayscale-80);
                        padding: 1.5rem 1rem;
                        transition: var(--time-normal) var(--cubic-normal);
                        transition-property: flex, background-color, border-color;

                        @media (max-width: $tablet) {
                            padding: 1rem;
                        }

                        &__title {
                            display: flex;
                            align-items: center;
                            gap: 0.6rem;
                        }

                        &__more {
                            flex: 1 0 0;
                            display: flex;
                            flex-direction: column;
                            margin: 0;
                            opacity: 0;
                            max-height: 0rem;
                            transition-property: max-height, opacity, margin;
                            transition: var(--time-normal) var(--cubic-normal);

                            &-description {
                                color: var(--grayscale-30);
                                flex: 1 0 0;

                                @media (max-width: $tablet) {
                                    max-height: 6.3rem;
                                    display: -webkit-box;
                                    -webkit-line-clamp: 5;
                                    -webkit-box-orient: vertical;
                                    overflow: hidden;
                                    text-overflow: ellipsis;
                                }
                            }

                            &-subdescription {
                                display: flex;
                                gap: 1rem;
                                font-family: var(--font-mono);

                                @media (max-width: $tablet) {
                                    flex-direction: column;
                                    gap: 0.5rem;
                                }

                                .experience,
                                .keywords {
                                    display: flex;
                                    flex-direction: column;

                                    .title {
                                        color: var(--grayscale-40);
                                    }
                                    .value {
                                        font-weight: 800;
                                        font-family: var(--font-mono);
                                        white-space: nowrap;
                                    }
                                }
                                .keywords {
                                    overflow: hidden;
                                    flex: 1 0 0;
                                    .value {
                                        overflow: hidden;
                                        text-overflow: ellipsis;
                                    }
                                }
                            }
                        }
                        &__progress {
                            margin: 1rem 0 0 0;
                            padding: 0;
                            list-style: none;
                            display: flex;
                            gap: 8px;
                            width: calc(100% - 2rem);
                            transition-property: transform, opacity, margin;
                            transition: var(--time-normal) var(--cubic-normal);

                            &-bar {
                                flex: 1 0 calc(100% / 5);
                                width: 100%;
                                height: 0.4rem;
                                transform: scaleX(0);
                                transform-origin: left;
                                transition: transform 100ms linear;

                                &.fill {
                                    background-color: var(--primary-color);
                                }

                                &:first-child {
                                    transition-delay: var(--time-normal);
                                    border-radius: 1rem 0 0 1rem;
                                }
                                &:nth-child(2) {
                                    transition-delay: 350ms;
                                }
                                &:nth-child(3) {
                                    transition-delay: 450ms;
                                }
                                &:nth-child(4) {
                                    transition-delay: 550ms;
                                }
                                &:last-child {
                                    transition-delay: 650ms;
                                    border-radius: 0 1rem 1rem 0;
                                }
                            }
                        }

                        &:hover {
                            flex: 1 0 0;

                            .skill__more {
                                margin-top: 1rem;
                                opacity: 1;
                                max-height: 16rem;
                            }
                            .skill__progress {
                                &-bar {
                                    &.fill {
                                        box-shadow: 0 0 8px rgba(19, 109, 236, 0.4);
                                    }
                                }
                            }
                        }
                    }
                    &:has(.skill:hover) {
                        .skill:not(:hover) {
                            flex: 0;

                            .skill__progress {
                                height: 0;
                                margin: 0;
                                opacity: 0;
                                transform: scaleY(0);
                            }
                        }
                    }
                }
            }
        }
    }
</style>
