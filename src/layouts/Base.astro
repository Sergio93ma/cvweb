---
import { Font } from 'astro:assets';
import '../styles/global.scss';
import { langPath, languages, ogLocale, runtimeDictionaries, t, type Lang } from '../i18n';

interface Props {
    lang: Lang;
    /** false for utility pages (404): noindex, no canonical/alternates, URL never rewritten */
    indexable?: boolean;
}

const { lang, indexable = true } = Astro.props;
const site = Astro.site!.origin;
const url = (l: Lang) => `${site}${langPath[l]}`;
const title = t(lang, 'meta.title');
const description = t(lang, 'meta.description');
const ogImage = `${site}/assets/images/profile_photo.webp`;

const personLd = {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Sergio Martín Alonso',
    url: site,
    image: ogImage,
    jobTitle: 'Senior Frontend Developer',
    sameAs: ['https://www.linkedin.com/in/sergio93ma/', 'https://github.com/sergio93ma'],
    description:
        'Frontend Developer with 9+ years of professional experience building scalable web applications with Angular, AEM and modern JavaScript ecosystem. Focused on performance, maintainability and real business impact.',
    worksFor: { '@type': 'Organization', name: 'Serbatic' },
};
const websiteLd = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Sergio Martín Alonso Portfolio',
    url: site,
};

/** JSON safe to embed inside a <script> element. */
const json = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <!-- Theme before first paint (cookie shared with the old site) -->
        <script is:inline>
            if (document.cookie.split(';').some((c) => c.trim() === 'theme-preference=light')) {
                document.documentElement.classList.add('light-theme');
            }
        </script>

        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="author" content="Sergio Martín Alonso" />
        {
            indexable ? (
                <>
                    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
                    <link rel="canonical" href={url(lang)} />
                    {languages.map((l) => (
                        <link rel="alternate" hreflang={l} href={url(l)} />
                    ))}
                    <link rel="alternate" hreflang="x-default" href={url('en')} />
                </>
            ) : (
                <meta name="robots" content="noindex" />
            )
        }

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={url(lang)} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="896" />
        <meta property="og:image:height" content="1200" />
        <meta property="og:site_name" content="Sergio Martín Alonso Portfolio" />
        <meta property="og:locale" content={ogLocale[lang]} />
        {languages.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        <meta name="twitter:creator" content="@sergio93ma" />

        <meta name="theme-color" content="#130DEC" />
        <meta name="mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
        <meta name="apple-mobile-web-app-title" content="Sergio Martín" />

        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="apple-touch-icon" href="/favicon.ico" />
        <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

        <Font cssVariable="--font-inter" preload />
        <Font cssVariable="--font-mono" />

        <script type="application/ld+json" set:html={json(personLd)} />
        <script type="application/ld+json" set:html={json(websiteLd)} />
    </head>
    <body>
        <slot />

        <!--
            Instant language switch: both flattened dictionaries are embedded once.
            Runs before first paint, so a saved/browser language different from the URL never flashes.
        -->
        <script type="application/json" id="i18n-data" set:html={json(runtimeDictionaries)} />
        <script is:inline define:vars={{ pageLang: lang, paths: langPath, syncUrl: indexable }}>
            const dicts = JSON.parse(document.getElementById('i18n-data').textContent);
            const root = document.documentElement;
            const toggle = document.getElementById('language-toggle');

            const apply = (lang) => {
                const d = dicts[lang];
                for (const el of document.querySelectorAll('[data-i18n]')) el.textContent = d[el.dataset.i18n];
                for (const el of document.querySelectorAll('[data-i18n-html]')) el.innerHTML = d[el.dataset.i18nHtml];
                for (const el of document.querySelectorAll('[data-i18n-attr]')) {
                    for (const pair of el.dataset.i18nAttr.split(';')) {
                        const [attr, key] = pair.split(':');
                        el.setAttribute(attr, d[key]);
                    }
                }
                root.lang = lang;
                document.title = d['meta.title'];
                document.querySelector('meta[name="description"]')?.setAttribute('content', d['meta.description']);
                if (toggle) toggle.checked = lang === 'es';
                if (syncUrl && location.pathname !== paths[lang]) history.replaceState(null, '', paths[lang] + location.hash);
            };

            const storage = {
                get: () => { try { return localStorage.getItem('language'); } catch { return null; } },
                set: (v) => { try { localStorage.setItem('language', v); } catch {} },
            };

            const saved = storage.get();
            const browser = navigator.language.split('-')[0] === 'es' ? 'es' : 'en';
            // Saved choice wins; otherwise the browser language, except on an explicit /es/ URL.
            const initial = saved in dicts ? saved : pageLang === 'en' ? browser : pageLang;
            if (initial !== pageLang) apply(initial);
            else if (toggle) toggle.checked = initial === 'es';

            toggle?.addEventListener('change', () => {
                const lang = toggle.checked ? 'es' : 'en';
                storage.set(lang);
                apply(lang);
            });
        </script>
    </body>
</html>
